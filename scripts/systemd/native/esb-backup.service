[Unit]
Description=Push ESB outage raw logs to a git remote
Documentation=https://github.com/baz8080/esb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=esb
Group=esb
StateDirectory=esb-outages
Environment=ESB_DATA_DIR=/var/lib/esb-outages

# The deploy key lives outside the data directory on purpose: the service
# user's home *is* that directory, so a key in the default location would sit
# inside the tree being backed up.
# Quoted: systemd splits an unquoted Environment= value on whitespace into
# separate assignments, which would set GIT_SSH_COMMAND to just "ssh".
Environment="GIT_SSH_COMMAND=ssh -i /etc/esb-outages-deploy-key -o IdentitiesOnly=yes -o UserKnownHostsFile=/etc/esb-outages-known_hosts -o StrictHostKeyChecking=accept-new"

EnvironmentFile=-/etc/esb-outages.env
ExecStart=/opt/esb-outages/scripts/backup-to-git.sh

[Install]
WantedBy=multi-user.target
