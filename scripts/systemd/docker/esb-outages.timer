[Unit]
Description=Run the ESB outage collector hourly
Documentation=https://github.com/baz8080/esb

[Timer]
OnCalendar=hourly

# Run immediately if the machine was off or asleep when a trigger was due. This
# is the whole reason a timer beats cron here: ESB purges outages a few hours
# after restoration, so a missed window is data lost permanently.
Persistent=true

# Do not hammer the API on the hour along with everyone else's cron.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
