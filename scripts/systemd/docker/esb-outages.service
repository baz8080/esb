[Unit]
Description=Collect ESB Networks outage data
Documentation=https://github.com/baz8080/esb
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot

# Put ESB_ALERT_WEBHOOK (and ESB_API_KEY if ESB ever rotates it) here, chmod 600.
# The leading '-' means the unit still starts if the file does not exist.
EnvironmentFile=-/etc/esb-outages.env

Environment=ESB_DATA_DIR=/var/lib/esb-outages
Environment=DATA_DIR=/var/lib/esb-outages

# If the Pi lost power mid-run, --rm never completed and the named container is
# still present; without this every later run fails with "name already in use".
ExecStartPre=-/usr/bin/docker rm -f esb-outages-poll
ExecStartPre=/bin/mkdir -p ${DATA_DIR}
ExecStartPre=/bin/chown -R 1000:1000 ${DATA_DIR}

ExecStart=/usr/bin/docker run --rm \
    --name esb-outages-poll \
    -v ${DATA_DIR}:/data \
    -e TZ=Europe/Dublin \
    -e ESB_ALERT_WEBHOOK \
    -e ESB_API_KEY \
    esb-outages:latest poll

# A single failed run is not an emergency: the outage stays listed for hours and
# the next run picks it up. The poller pushes its own alert for anything real.
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
