[Unit]
Description=Collect ESB Networks outage data
Documentation=https://github.com/baz8080/esb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=esb
Group=esb

# systemd creates /var/lib/esb-outages with the right ownership before every
# run, so there is no directory-permission setup to get wrong.
StateDirectory=esb-outages
Environment=ESB_DATA_DIR=/var/lib/esb-outages

# ESB_ALERT_WEBHOOK, ESB_HEARTBEAT_URL, and ESB_API_KEY if ESB ever rotates
# the public one.
# chmod 600, owned by root. The leading '-' allows the file not to exist.
EnvironmentFile=-/etc/esb-outages.env

WorkingDirectory=/opt/esb-outages
ExecStart=/usr/bin/python3 -m esb_outages poll

# A storm can list more than a run can fetch. Stopped at 25 minutes, inside the
# 30-minute interval, with about 3,000 details reached at half a second each;
# the collector catches SIGTERM, records the run, and the next run takes what
# was left first (notes/storms.md).
TimeoutStartSec=1500

# It reads its own code and writes one state directory. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
