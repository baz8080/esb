[Unit]
Description=Back up ESB outage data every six hours
Documentation=https://github.com/baz8080/esb

[Timer]
# Every six hours, local. The site is only ever as current as the last push, so
# this caps how old the page can look; esb_site.render.STALE_AFTER is sized to it.
OnCalendar=*-*-* 00,06,12,18:00:00
Persistent=true
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
